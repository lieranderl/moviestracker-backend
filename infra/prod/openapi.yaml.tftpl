swagger: "2.0"
info:
  title: MoviesTracker API
  version: "1.0"
schemes: [https]
produces: [application/json]
securityDefinitions:
  api_key:
    type: apiKey
    name: key
    in: query
security:
  - api_key: []
paths:
  /getimdb:
    get:
      operationId: getIMDbRating
      parameters:
        - name: imdb_id
          in: query
          required: true
          type: string
          pattern: '^tt[0-9]+$'
      x-google-backend:
        address: ${backend_url}/getimdb
        jwt_audience: ${backend_url}
        path_translation: CONSTANT_ADDRESS
      responses:
        "200":
          description: IMDb rating
        "400":
          description: Invalid IMDb ID
        "404":
          description: Rating not found
